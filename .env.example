DATABASE_URL=postgresql://ygg:ygg_local_only@localhost:54329/yggcoffe
APP_ORIGIN=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
CRON_SECRET=
# Only enable behind a proxy that overwrites the selected IP header.
TRUST_PROXY=false
# Production: set to x-vercel-forwarded-for on Vercel, or your sanitized proxy header.
TRUSTED_IP_HEADER=x-real-ip
# Payments stay disabled until the integration team implements and registers adapters.
PAYMENT_PROVIDER=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
INFINITEPAY_HANDLE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# DELIVERY_FLAT_RATE_CENTS must be set to an actual shipping rate before sales.
DELIVERY_FLAT_RATE_CENTS=
# Docker Compose local lab (never reuse local defaults on a public server).
DOCKER_APP_ORIGIN=http://localhost:18080
DOCKER_HTTP_PORT=18080
DOCKER_POSTGRES_PASSWORD=ygg_local_only
