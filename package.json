{
  "name": "yggcoffe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:docker": "playwright test --config playwright.docker.config.ts",
    "test:docker": "docker compose -f compose.test.yaml up -d --wait && pnpm test:integration",
    "docker:up": "docker compose --profile store build app proxy && docker compose --profile store up -d --no-build --wait",
    "docker:stop": "docker compose --profile store stop",
    "docker:desktop": "node scripts/docker-desktop.mjs",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "graphql": "17.0.2",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "nodemailer": "10.2.0",
    "otpauth": "9.5.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
